# Copy to .env.local (gitignored) and fill in from Supabase → Project Settings → API Keys.
# Both values are safe in the browser: Row Level Security protects the data.
# Never put the secret / service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# PostHog → Project Settings → Project API key (public, starts with phc_). Leave empty to turn analytics off.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
