# Copy to .env.local (gitignored) and fill in from Supabase → Project Settings → API Keys.
# Both values are safe in the browser: Row Level Security protects the data.
# Never put the secret / service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# PostHog → Project Settings → Project API key (public, starts with phc_). Leave empty to turn analytics off.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile site key (public) for sign-up, sign-in, and password reset. Must pair with the secret in
# Supabase Auth → captcha. Local development: Cloudflare's always-pass test key below (it pairs with the test
# secret in supabase/config.toml). Production: the real key from Cloudflare → Turnstile.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
